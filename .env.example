# Leave these empty to run Rider in local mode (data saved in the browser, sign-in simulated).
# Fill them in to use Supabase for accounts, storage and the partner API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used by the partner API to read a rider on behalf of a connected app.
SUPABASE_SERVICE_ROLE_KEY=

# The public origin of this app, used in OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
